{
  "name": "sql",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "SQL content repo for GraphL \u2014 authors scenes (react-flow diagrams / code snippets) per section, renders them full-frame, and captures screenshots + coords for the compose pipeline. The render engine is the @graphlearning/flow package.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "node scripts/check-content.mjs && node scripts/check-plan.mjs",
    "preview": "vite preview",
    "build:snapshot": "vite build --outDir dist-snapshot",
    "capture": "vite preview --outDir dist-snapshot --port 5181",
    "capture:shots": "graphl-capture-shots",
    "record": "graphl-record",
    "record:reels": "graphl-record-reels",
    "record:all": "caffeinate -ims graphl-record-all",
    "shots:4k": "graphl-shots-4k",
    "gen:audio": "graphl-gen-audio",
    "gen:desc": "graphl-gen-desc",
    "thumb": "graphl-thumb",
    "check:sql": "node scripts/check-sql.mjs",
    "db:reset": "psql -X -q -v ON_ERROR_STOP=1 -f db/schema.sql -f db/seed.sql -f db/perf.sql",
    "shot": "node scripts/shot.mjs"
  },
  "dependencies": {
    "@graphlearning/flow": "^1.2.0",
    "@graphlearning/shell": "^0.10.1",
    "@xyflow/react": "^12.11.2",
    "lucide-react": "^1.28.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.0",
    "puppeteer": "^25.3.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.5"
  }
}
